
@{
    ViewBag.Title = "Visor de casos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css" rel="stylesheet" />
<script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>

<div class="row">
    <div class="col-md-12">
        <a href="/Case/Create" class="btn btn-success">Nuevo Caso</a>
    </div>
</div>
<div class="row">
    <div class="col-md-12 table-responsive">
        <table class="table" id="tblCasos">
        </table>
    </div>
</div>
<script>
    var tbl;
    var arrayItems;

    $(document).ready(function () {
        GetAllCases();
    });

    function GetAllCases() {
        GetMVC("/Case/GetAllCases", function (r) {
            if (r.Result.Successful) {
                arrayItems = r.CaseObjs;
                tbl = $("#tblCasos").DataTable(
                    {
                        data: arrayItems,
                        columns: [
                            { data: "Id", title: "Id" },
                            { data: "NumeroCaso", title: "Número de Caso" },
                            { data: "Cliente.Nombre", title: "Cliente" },
                            { data: "Cliente.Telefono", title: "Teléfono" },
                            { data: "Estatus", title: "Estatus" },
                            {
                                data: "Id", render: function (data) {
                                    return '<input type="button" value="Editar" class="btn btn-primary" onclick="EditCase(' + data + ')" />'
                                }
                            }
                        ]
                    });
            }
            else {
                alert(r.Message);
            }
        });
    }

    function EditCase(id) {
        window.location.href = "/Case/Create/" + id;
    }
</script>