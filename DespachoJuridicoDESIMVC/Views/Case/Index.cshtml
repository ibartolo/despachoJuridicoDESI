
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/CSS/Case/Index.css" rel="stylesheet" />

<!-- Encabezado de página -->
<div class="page-header">
    <div>
        <h1 class="page-title">Gestión de Casos</h1>
        <p class="page-subtitle">Registra y administra los casos legales del despacho</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-default" id="btnListaCasos">
            <i class="fa fa-list"></i> Ver Lista
        </button>
        <button class="btn btn-success" id="btnNuevoCaso">
            <i class="fa fa-plus"></i> Nuevo Caso
        </button>
    </div>
</div>

<!-- Contenedor del formulario -->
<div class="form-container">
    <!-- Sección de información básica -->
    <div class="form-section">
        <h3 class="section-title">Información Básica del Caso</h3>

        <div class="row">
            <!-- Número de caso -->
            <div class="col-md-4 col-sm-6">
                <div class="form-group required">
                    <label for="numeroCaso">Número de Caso</label>
                    <div class="case-number-container">
                        <input type="text" class="form-control" id="numeroCaso"
                               placeholder="Ej: C-2023-001" maxlength="100" required>
                        <button type="button" class="btn btn-default" id="btnGenerarNumero" title="Generar número automático">
                            <i class="fa fa-refresh"></i>
                        </button>
                    </div>
                    <div class="validation-message error" id="numeroCasoError"></div>
                </div>
            </div>

            <!-- Cliente (combobox/selector) -->
            <div class="col-md-4 col-sm-6">
                <div class="form-group required">
                    <label for="clienteId">Cliente</label>
                    <div class="input-icon">
                        <i class="fa fa-user"></i>
                        <select class="form-control" id="clienteId" required>
                            <option value="">Seleccionar cliente...</option>
                            <!-- Opciones se cargarán dinámicamente -->
                        </select>
                    </div>
                    <div class="validation-message error" id="clienteIdError"></div>
                    <button type="button" class="btn btn-link btn-sm" id="btnBuscarCliente" style="padding: 0; margin-top: 5px;">
                        <i class="fa fa-search"></i> Buscar cliente
                    </button>
                </div>
            </div>

            <!-- Estatus del caso (combobox) -->
            <div class="col-md-4 col-sm-6">
                <div class="form-group required">
                    <label for="estatusCasoId">Estatus del Caso</label>
                    <div class="input-icon">
                        <i class="fa fa-flag"></i>
                        <select class="form-control" id="estatusCasoId" required>
                            <option value="">Seleccionar estatus...</option>
                            <!-- Opciones se cargarán dinámicamente -->
                        </select>
                    </div>
                    <div class="validation-message error" id="estatusCasoIdError"></div>
                </div>
            </div>
        </div>

        <!-- Descripción -->
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label for="descripcion">Descripción del Caso</label>
                    <textarea class="form-control" id="descripcion"
                              placeholder="Describe los detalles del caso legal..."
                              maxlength="500" rows="3"></textarea>
                    <div class="text-right" style="font-size: 12px; color: #999; margin-top: 5px;">
                        <span id="descripcionContador">0</span>/500 caracteres
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de información financiera -->
    <div class="form-section">
        <h3 class="section-title">Información Financiera</h3>

        <div class="row">
            <!-- Monto inicial -->
            <div class="col-md-4 col-sm-6">
                <div class="form-group required">
                    <label for="montoInicial">Monto Inicial</label>
                    <div class="currency-input">
                        <input type="number" class="form-control" id="montoInicial"
                               min="0" step="0.01" placeholder="0.00" required>
                    </div>
                    <div class="validation-message error" id="montoInicialError"></div>
                </div>
            </div>

            <!-- Estatus activo/inactivo -->
            <div class="col-md-4 col-sm-6">
                <div class="form-group">
                    <label>Estatus del Registro</label>
                    <div class="switch-container">
                        <label class="switch">
                            <input type="checkbox" id="estatus" checked>
                            <span class="slider"></span>
                        </label>
                        <span class="switch-label" id="estatusLabel">Activo</span>
                    </div>
                    <p class="help-block" style="font-size: 12px; color: #999; margin-top: 5px;">
                        Activo: El caso está en proceso. Inactivo: El caso está cerrado o archivado.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de auditoría (solo lectura) -->
    <div class="form-section" id="seccionAuditoria" style="display: none;">
        <h3 class="section-title">Información de Auditoría</h3>

        <div class="audit-info">
            <div class="audit-title">Registro de cambios</div>

            <div class="audit-row">
                <div class="audit-label">Creado por:</div>
                <div class="audit-value" id="createdBy">-</div>
            </div>

            <div class="audit-row">
                <div class="audit-label">Fecha creación:</div>
                <div class="audit-value" id="createdDt">-</div>
            </div>

            <div class="audit-row">
                <div class="audit-label">Última modificación por:</div>
                <div class="audit-value" id="updatedBy">-</div>
            </div>

            <div class="audit-row">
                <div class="audit-label">Fecha modificación:</div>
                <div class="audit-value" id="updatedDt">-</div>
            </div>
        </div>
    </div>

    <!-- Acciones del formulario -->
    <div class="form-actions">
        <button type="button" class="btn btn-default" id="btnCancelar">
            <i class="fa fa-times"></i> Cancelar
        </button>
        <button type="button" class="btn btn-danger" id="btnEliminar" style="display: none;">
            <i class="fa fa-trash"></i> Eliminar
        </button>
        <button type="submit" class="btn btn-primary" id="btnGuardar">
            <i class="fa fa-save"></i> Guardar Caso
        </button>
    </div>
</div>

<script src="~/Scripts/Case/Index.js"></script>