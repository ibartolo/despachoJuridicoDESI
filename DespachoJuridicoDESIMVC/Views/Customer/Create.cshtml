@model DespachoJuridicoDESIMVC.Models.Customer.ClienteObj
@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>

<div class="row">
    <div class="col-md-12">
        @using (Html.BeginForm("SaveOrUpdateCliente", "Customer", FormMethod.Post, new { enctype = "multipart/form-data", @name = "frmCustomerCrud", @id = "frmCustomerCrud" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.CreatedBy)
            @Html.HiddenFor(x => x.CreatedDt)
            @Html.HiddenFor(x => x.Estatus)

            @* Mostrar errores del servidor (ModelState) *@
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors text-danger", role = "alert" })

            <div class="row">
                <div class="col-md-4">
                    <label>Nombre:</label>
                    @Html.TextBoxFor(x => x.Nombre, new { @class = "form-control", @placeholder = "Nombre del cliente" })
                    @Html.ValidationMessageFor(x => x.Nombre, "", new { @class = "field-validation-error" })
                </div>
                <div class="col-md-4">
                    <label>Teléfono:</label>
                    @Html.TextBoxFor(x => x.Telefono, new { @class = "form-control", @placeholder = "Teléfono del cliente" })
                    @Html.ValidationMessageFor(x => x.Telefono, "", new { @class = "field-validation-error" })
                </div>
                <div class="col-md-4">
                    <label>Correo electrónico:</label>
                    @Html.TextBoxFor(x => x.Correo, new { @class = "form-control", @placeholder = "Correo electrónico del cliente" })
                    @Html.ValidationMessageFor(x => x.Correo, "", new { @class = "field-validation-error" })
                </div>
            </div>

            <div class="row" style="margin-top:15px;">
                <div class="col-md-12">
                    <input type="submit" value="Guardar" class="btn btn-success" />
                    <a href="/Customer/Index" class="btn btn-warning">Cancelar</a>
                </div>
            </div>
        }
    </div>
</div>

<script>
    $(function () {
        $("#frmCustomerCrud").validate({
            rules: {
                "Nombre": "required",
                "Telefono": "required",
                "Correo": {
                    "email": true
                }
            },
            messages: {
                "Nombre": "El campo 'Nombre' es requerido.",
                "Telefono": "El campo 'Descripción' es requerido.",
                "Correo": {
                    "email": "El correo electronico, no tiene el formato correcto"
                }
            }
        });
    });
</script>