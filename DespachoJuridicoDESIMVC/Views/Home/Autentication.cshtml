
@{
    ViewBag.Title = "Autenticación";
    Layout = "~/Views/Shared/_Autentication.cshtml";
}

<!-- Contenedor principal de autenticación -->
<div class="auth-container">
    <!-- Encabezado -->
    <div class="auth-header">
        <img src="https://img.genially.com/63eeeed672cc8d001897dffb/775b7efe-efa0-441b-9c8a-e056dc20afa4.png" alt="Logo Despacho Jurídico" class="auth-logo">
        <h1 class="auth-title">Despacho Jurídico</h1>
        <p class="auth-subtitle">Sistema de Gestión Legal Vera</p>
    </div>

    <!-- Cuerpo -->
    <div class="auth-body">
        <div class="alert alert-error" id="errorAlert">
            <i class="fa fa-exclamation-circle"></i> <span id="errorMessage">Credenciales incorrectas. Intente nuevamente.</span>
        </div>

        <div class="alert alert-success" id="successAlert">
            <i class="fa fa-check-circle"></i> <span id="successMessage">¡Inicio de sesión exitoso! Redirigiendo...</span>
        </div>

        @*<button class="btn btn-google" id="googleLogin">
            <i class="fa fa-google btn-icon"></i>
            <span class="btn-text">Continuar con Google</span>
            <div class="loader"></div>
        </button>

        <button class="btn btn-facebook" id="facebookLogin">
            <i class="fa fa-facebook btn-icon"></i>
            <span class="btn-text">Continuar con Facebook</span>
            <div class="loader"></div>
        </button>

        <div class="separator">
            <span class="separator-text">o ingresa con tu cuenta</span>
        </div>*@

        <!-- Formulario de inicio de sesión -->
        <form class="auth-form" id="loginForm">
            <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <div class="input-with-icon">
                    <i class="fa fa-envelope"></i>
                    <input type="email" id="email" class="form-control" placeholder="correo@ejemplo.com" required>
                </div>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <div class="input-with-icon">
                    <i class="fa fa-lock"></i>
                    <input type="password" id="password" class="form-control" placeholder="Ingresa tu contraseña" required>
                </div>
            </div>

            @*<div class="checkbox-container">
                <input type="checkbox" id="rememberMe">
                <label for="rememberMe">Recordar mi sesión</label>
            </div>*@

            <button type="submit" class="btn btn-primary" id="submitLogin">
                <span class="btn-text">Iniciar Sesión</span>
                <div class="loader"></div>
            </button>
        </form>

        <!-- Enlaces adicionales -->
        <div class="auth-links">
            <a href="#" id="forgotPassword">¿Olvidaste tu contraseña?</a>
            <span class="separator-link">|</span>
            <a href="#" id="registerLink">Crear nueva cuenta</a>
        </div>
    </div>

    <!-- Pie de página -->
    <div class="auth-footer">
        <p>© 2023 Despacho Jurídico. Todos los derechos reservados.</p>
        <p><a href="#" style="color: #666;">Política de privacidad</a> | <a href="#" style="color: #666;">Términos de servicio</a></p>
    </div>
</div>

<!-- Modal para recuperación de contraseña -->
<div class="modal-overlay" id="recoveryModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Recuperar Contraseña</h3>
            <p>Ingresa tu correo electrónico para recibir un enlace de recuperación.</p>
        </div>

        <div class="modal-body">
            <div class="form-group">
                <label for="recoveryEmail">Correo Electrónico</label>
                <input type="email" id="recoveryEmail" class="form-control" placeholder="correo@ejemplo.com">
            </div>

            <div class="alert alert-success" id="recoverySuccess" style="display: none;">
                <i class="fa fa-check-circle"></i> Se ha enviado un enlace de recuperación a tu correo.
            </div>

            <div class="alert alert-error" id="recoveryError" style="display: none;">
                <i class="fa fa-exclamation-circle"></i> <span id="recoveryErrorMessage">Error al enviar el enlace.</span>
            </div>
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary btn-small" id="cancelRecovery">Cancelar</button>
            <button class="btn btn-primary btn-small" id="sendRecovery">Enviar Enlace</button>
        </div>
    </div>
</div>

<!-- Modal para registro de nueva cuenta -->
<div class="modal-overlay" id="registerModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Crear Nueva Cuenta</h3>
            <p>Regístrate para acceder al sistema de gestión legal.</p>
        </div>

        <div class="modal-body">
            <form id="registerForm">
                <div class="form-group">
                    <label for="registerName">Nombre Completo</label>
                    <input type="text" id="registerName" class="form-control" placeholder="Nombre y apellidos">
                </div>

                <div class="form-group">
                    <label for="registerEmail">Correo Electrónico</label>
                    <input type="email" id="registerEmail" class="form-control" placeholder="correo@ejemplo.com">
                </div>

                <div class="form-group">
                    <label for="registerPassword">Contraseña</label>
                    <input type="password" id="registerPassword" class="form-control" placeholder="Mínimo 8 caracteres">
                </div>

                <div class="form-group">
                    <label for="registerConfirmPassword">Confirmar Contraseña</label>
                    <input type="password" id="registerConfirmPassword" class="form-control" placeholder="Repite tu contraseña">
                </div>

                <div class="checkbox-container">
                    <input type="checkbox" id="acceptTerms" required>
                    <label for="acceptTerms">Acepto los <a href="#" style="color: var(--color-secundario);">términos y condiciones</a> del servicio</label>
                </div>

                <div class="alert alert-success" id="registerSuccess" style="display: none;">
                    <i class="fa fa-check-circle"></i> ¡Cuenta creada exitosamente! Redirigiendo...
                </div>

                <div class="alert alert-error" id="registerError" style="display: none;">
                    <i class="fa fa-exclamation-circle"></i> <span id="registerErrorMessage">Error al crear la cuenta.</span>
                </div>
            </form>
        </div>

        <div class="modal-footer">
            <button class="btn btn-secondary btn-small" id="cancelRegister">Cancelar</button>
            <button class="btn btn-primary btn-small" id="submitRegister">Crear Cuenta</button>
        </div>
    </div>
</div>