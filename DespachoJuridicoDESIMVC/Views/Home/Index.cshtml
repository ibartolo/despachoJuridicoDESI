﻿@model DespachoJuridicoDESIMVC.Models.Dashboard.DashboardObj
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Fila de estadísticas -->
    <div class="row row-spacing">
        <div class="col-md-3 col-sm-6">
            <div class="stat-card casos">
                <div class="stat-number">@Model.Summary.CasosActivos</div>
                <div class="stat-label">Casos Activos</div>
                <div class="stat-change positive">
                    <i class="fa fa-arrow-up"></i> @Model.Summary.NuevosCasosSemana nuevos esta semana
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card expedientes">
                <div class="stat-number">@Model.Summary.ExpedientesTotales</div>
                <div class="stat-label">Expedientes</div>
                <div class="stat-change positive">
                    <i class="fa fa-arrow-up"></i> @Model.Summary.ExpedientesTotales% vs mes anterior
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card clientes">
                <div class="stat-number">@Model.Summary.ClientesActivos</div>
                <div class="stat-label">Clientes Activos</div>
                <div class="stat-change positive">
                    <i class="fa fa-arrow-up"></i> @Model.Summary.NuevosClientesMes nuevos este mes
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card pagos">
                <div class="stat-number">$@Model.Summary.IngresosTotales.ToString("N0")</div>
                <div class="stat-label">Ingresos Totales</div>
                <div class="stat-change positive">
                    <i class="fa fa-arrow-up"></i> 12% vs mes anterior
                </div>
            </div>
        </div>
    </div>

    <!-- Fila de actividades y próximos eventos -->
    <div class="row row-spacing">
        <div class="col-md-8">
            <h3 class="section-title">Actividad Reciente</h3>
            <div class="activity-list">
                @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                {
                    foreach (var activity in Model.RecentActivities)
                    {
                        var iconClass = activity.Actividad == "Nuevo caso" ? "case" :
                                        activity.Actividad == "Nuevo cliente" ? "client" :
                                        activity.Actividad == "Pago recibido" ? "payment" : "case";
                        var icon = activity.Actividad == "Nuevo caso" ? "fa-gavel" :
                                   activity.Actividad == "Nuevo cliente" ? "fa-user-plus" :
                                   activity.Actividad == "Pago recibido" ? "fa-credit-card" : "fa-file-text";

                        <div class="activity-item">
                            <div class="activity-icon @iconClass">
                                <i class="fa @icon"></i>
                            </div>
                            <div class="activity-content">
                                <div class="activity-text">
                                    <strong>@activity.Actividad:</strong> "@activity.Referencia" - @activity.Detalle
                                </div>
                                <div class="activity-time">@activity.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="activity-item">
                        <div class="activity-content">
                            <div class="activity-text">
                                <span style="color: #999;">No hay actividad reciente</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <h3 class="section-title">Próximos Eventos</h3>
            <div class="calendar-card">
                <div class="calendar-header">
                    <h4 class="calendar-month">@DateTime.Now.ToString("MMMM yyyy")</h4>
                </div>
                <div class="calendar-body">
                    @if (Model.UpcomingEvents != null && Model.UpcomingEvents.Any())
                    {
                        foreach (var evt in Model.UpcomingEvents)
                        {
                            <div class="event-item">
                                <div class="event-time">@evt.FechaInicio.ToString("hh:mm tt")</div>
                                <div class="event-title">@evt.Titulo</div>
                                <div class="event-desc">@evt.CasoNumero - @evt.TipoEvento</div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="event-item">
                            <div class="event-desc" style="text-align: center; color: #999;">No hay eventos próximos</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript Específico para Dashboard -->
<script>
    /* ===================================
       JAVASCRIPT ESPECÍFICO PARA DASHBOARD
       =================================== */

    $(document).ready(function () {
        // Efecto hover en tarjetas de estadísticas
        $('.stat-card').hover(
            function () {
                $(this).css('cursor', 'pointer');
            },
            function () {
                // Sin acción al salir
            }
        );

        // Mostrar mensaje de bienvenida
        setTimeout(function () {
            console.log("Dashboard cargado correctamente. Bienvenido al sistema de gestión del despacho jurídico.");
        }, 1000);
    });
</script>